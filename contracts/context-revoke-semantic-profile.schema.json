{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://egopulse.local/contracts/context-revoke-semantic-profile/v0.1",
  "title": "EgoPulse Context Revoke Semantic Confirmation Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contractId", "contractVersion", "authorityRef", "domainSeparator", "digest", "canonicalEncoding", "semanticFieldOrder", "excludedFields", "confirmation", "newCommitValidation", "historicalReplay", "fixtureRefs"],
  "properties": {
    "schemaVersion": { "const": "egopulse.context-revoke-semantic-profile/v0.1" },
    "contractId": { "const": "egopulse.context-revoke-confirmation.v1" },
    "contractVersion": { "const": "0.1.0" },
    "authorityRef": { "const": "conversation:2026-08-31:founder-r9a-gate11-scheme-c" },
    "domainSeparator": { "const": "egopulse/context-revoke/v1" },
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "outputEncoding", "outputCharacters"],
      "properties": {
        "algorithm": { "const": "SHA-256" },
        "outputEncoding": { "const": "lowercase_hex" },
        "outputCharacters": { "const": 64 }
      }
    },
    "canonicalEncoding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fieldEnvelope", "stringEncoding", "unsignedIntegerEncoding", "listEncoding", "normalization", "evidenceOrder"],
      "properties": {
        "fieldEnvelope": { "const": "u64_le_byte_length_then_raw_value" },
        "stringEncoding": { "const": "utf8" },
        "unsignedIntegerEncoding": { "const": "u64_le_value_wrapped_as_field" },
        "listEncoding": { "const": "u64_le_item_count_wrapped_as_field_then_each_item_as_field" },
        "normalization": { "const": "none" },
        "evidenceOrder": { "const": "preserve_request_order" }
      }
    },
    "semanticFieldOrder": {
      "const": ["domain_separator", "founder_principal_id", "snapshot_id", "expected_state_revision", "reason_code", "evidence_refs_count", "evidence_refs_each", "confirmation_proof_ref"]
    },
    "excludedFields": {
      "const": ["command_id", "idempotency_key", "idempotency_scope", "issued_at", "correlation_id", "causation_id", "request_id", "client_instance_id", "client_surface", "presentation_text"]
    },
    "confirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestField", "principalSource", "gatewayRule", "missingOrInvalidRule"],
      "properties": {
        "requestField": { "const": "RevokeContextSnapshotCommand.metadata.request_digest_sha256" },
        "principalSource": { "const": "authenticated_local_session" },
        "gatewayRule": { "const": "recompute_exact_match_before_context_authority" },
        "missingOrInvalidRule": { "const": "reject_before_context_authority_zero_calls" }
      }
    },
    "newCommitValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reasonCode", "evidenceRefs", "confirmationProofRef", "normalization", "rawOrEncodedContextProviderContent"],
      "properties": {
        "reasonCode": {
          "type": "object",
          "additionalProperties": false,
          "required": ["syntax", "pattern", "minBytes", "maxBytes"],
          "properties": {
            "syntax": { "const": "lowercase_ascii_slug" },
            "pattern": { "const": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
            "minBytes": { "const": 1 },
            "maxBytes": { "const": 128 }
          }
        },
        "evidenceRefs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["syntax", "pattern", "minItems", "maxItems", "maxItemBytes", "maxTotalBytes", "preserveRequestOrder"],
          "properties": {
            "syntax": { "const": "lowercase_ascii_namespaced_ref" },
            "pattern": { "const": "^[a-z0-9]+(?:-[a-z0-9]+)*(?::[a-z0-9]+(?:-[a-z0-9]+)*)+$" },
            "minItems": { "const": 1 },
            "maxItems": { "const": 16 },
            "maxItemBytes": { "const": 512 },
            "maxTotalBytes": { "const": 4096 },
            "preserveRequestOrder": { "const": true }
          }
        },
        "confirmationProofRef": {
          "type": "object",
          "additionalProperties": false,
          "required": ["syntax", "pattern", "minBytes", "maxBytes"],
          "properties": {
            "syntax": { "const": "lowercase_ascii_namespaced_ref" },
            "pattern": { "const": "^[a-z0-9]+(?:-[a-z0-9]+)*(?::[a-z0-9]+(?:-[a-z0-9]+)*)+$" },
            "minBytes": { "const": 1 },
            "maxBytes": { "const": 512 }
          }
        },
        "normalization": { "const": "reject_not_normalize" },
        "rawOrEncodedContextProviderContent": { "const": "forbidden" }
      }
    },
    "historicalReplay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["matchFields", "exactMatchResult", "changedSemanticsResult"],
      "properties": {
        "matchFields": {
          "const": ["authenticated_principal_id", "idempotency_key", "full_semantic_request_digest_sha256"]
        },
        "exactMatchResult": { "const": "return_original_receipt_with_replayed_true_zero_writes" },
        "changedSemanticsResult": { "const": "idempotency_conflict_before_new_commit_validation" }
      }
    },
    "fixtureRefs": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
