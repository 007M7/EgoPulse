{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://egopulse.local/gate3/v01/task-fixture-envelope-v0.1.schema.json",
  "title": "V-01 Gate 3 Task Contract Fixture Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "fixtureId", "category", "requirementRefs", "principal", "startingSnapshot", "resolvedReferences", "command", "expected"],
  "properties": {
    "schemaVersion": { "const": "v01-task-fixture/v0.1" },
    "fixtureId": { "type": "string", "minLength": 1 },
    "category": { "enum": ["valid", "invalid", "duplicate", "stale", "unauthorized", "recovery"] },
    "requirementRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "principal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "principalId", "authenticated"],
      "properties": {
        "kind": { "enum": ["FOUNDER", "FOUNDER_AUTHORITY", "TASK_AUTHORITY", "COLLABORATION_CONTROL", "SEGO_SVA", "HARNESS", "UNAUTHENTICATED"] },
        "principalId": { "type": "string", "minLength": 1 },
        "authenticated": { "type": "boolean" }
      }
    },
    "startingSnapshot": { "type": ["object", "null"] },
    "resolvedReferences": { "type": "object" },
    "command": { "type": "object", "minProperties": 1, "maxProperties": 1 },
    "expected": {
      "type": "object",
      "additionalProperties": true,
      "required": ["outcome", "businessWriteCount"],
      "properties": {
        "outcome": { "enum": ["committed", "replayed", "error"] },
        "businessWriteCount": { "type": "integer", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
