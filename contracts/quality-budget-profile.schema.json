{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://egopulse.local/contracts/quality-budget-profile/v0.1",
  "title": "EgoPulse V-01 Quality Budget Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "profileId", "profileVersion", "authorityRef", "designBindingGate", "verificationGate", "rules", "measurementPolicy"],
  "properties": {
    "schemaVersion": { "const": "egopulse.quality-budget-profile/v0.1" },
    "profileId": { "type": "string", "minLength": 1 },
    "profileVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "authorityRef": { "type": "string", "minLength": 1 },
    "designBindingGate": { "const": "Gate 3" },
    "verificationGate": { "const": "Gate 6" },
    "rules": {
      "type": "array",
      "minItems": 33,
      "maxItems": 33,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requirementId", "class", "metric", "limits", "failureDisposition"],
        "properties": {
          "requirementId": { "type": "string", "pattern": "^(QH|QT|QC|QR|QM)-[0-9]{2}$" },
          "class": { "enum": ["governance_redline", "latency", "concurrency", "resource", "model_usage"] },
          "metric": { "type": "string", "minLength": 1 },
          "limits": { "type": "object", "minProperties": 1, "additionalProperties": { "type": ["number", "integer", "boolean", "string"] } },
          "failureDisposition": { "type": "string", "minLength": 1 }
        }
      }
    },
    "measurementPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["releaseBuildRequired", "failedSamplesIncluded", "crashInjectionsPerBoundary", "crashBoundaryCount", "providerAndLocalLatencySeparated"],
      "properties": {
        "releaseBuildRequired": { "const": true },
        "failedSamplesIncluded": { "const": true },
        "crashInjectionsPerBoundary": { "const": 10 },
        "crashBoundaryCount": { "const": 8 },
        "providerAndLocalLatencySeparated": { "const": true }
      }
    }
  }
}
