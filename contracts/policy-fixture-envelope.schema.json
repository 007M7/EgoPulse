{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "egopulse://schemas/v01-policy-fixture-envelope/v0.1",
  "title": "V-01 Policy Decision Authority fixture envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "fixtureId", "category", "requirementRefs", "principal", "startingState", "resolvedReferences", "command", "expected"],
  "properties": {
    "schemaVersion": { "const": "v01-policy-fixture/v0.1" },
    "fixtureId": { "type": "string", "minLength": 1 },
    "category": { "enum": ["valid", "invalid", "duplicate", "stale", "unauthorized", "recovery"] },
    "requirementRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "principal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "principalId", "authenticated"],
      "properties": {
        "kind": { "enum": ["FOUNDER", "LOCAL_USER", "POLICY_AUTHORITY", "HARNESS_ADAPTER", "RECOVERY_COORDINATOR", "MODEL", "UNAUTHENTICATED"] },
        "principalId": { "type": "string", "minLength": 1 },
        "authenticated": { "type": "boolean" }
      }
    },
    "startingState": { "type": ["object", "null"] },
    "resolvedReferences": { "type": "object" },
    "command": { "type": "object", "minProperties": 1, "maxProperties": 1 },
    "expected": {
      "type": "object",
      "additionalProperties": true,
      "required": ["outcome", "businessWriteCount"],
      "properties": {
        "outcome": { "enum": ["committed", "replayed", "error"] },
        "businessWriteCount": { "type": "integer", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
