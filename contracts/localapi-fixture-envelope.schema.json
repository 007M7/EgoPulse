{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "egopulse://schemas/v01-localapi-fixture-envelope/v0.1",
  "title": "V-01 Local API fixture envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "fixtureId",
    "category",
    "requirementRefs",
    "principal",
    "transport",
    "operation",
    "expected"
  ],
  "properties": {
    "schemaVersion": { "const": "v01-localapi-fixture/v0.1" },
    "fixtureId": { "type": "string", "minLength": 1 },
    "category": {
      "enum": ["valid", "invalid", "duplicate", "stale", "unauthorized", "recovery"]
    },
    "requirementRefs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "principal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "principalId", "authenticated"],
      "properties": {
        "kind": {
          "enum": [
            "FOUNDER",
            "LOCAL_USER",
            "TASK_AUTHORITY",
            "HARNESS",
            "MODEL",
            "SYSTEM_PROJECTOR",
            "OTHER_OS_USER",
            "UNAUTHENTICATED"
          ]
        },
        "principalId": { "type": "string", "minLength": 1 },
        "authenticated": { "type": "boolean" }
      }
    },
    "transport": {
      "type": "object",
      "additionalProperties": true,
      "required": ["kind"],
      "properties": {
        "kind": {
          "enum": [
            "WINDOWS_NAMED_PIPE",
            "UNIX_DOMAIN_SOCKET",
            "LOOPBACK_TCP",
            "REMOTE_TCP",
            "IN_PROCESS"
          ]
        }
      }
    },
    "startingState": { "type": ["object", "null"] },
    "operation": { "type": "object", "minProperties": 1, "maxProperties": 1 },
    "ownerRetentionTombstone": { "type": "object" },
    "canonicalVectors": { "type": "object" },
    "retentionBoundary": { "type": "object" },
    "boundaryCases": { "type": "object" },
    "expected": {
      "type": "object",
      "additionalProperties": true,
      "required": ["outcome", "businessWriteCount"],
      "properties": {
        "outcome": { "enum": ["ok", "replayed", "error", "reset_required"] },
        "businessWriteCount": { "type": "integer", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
