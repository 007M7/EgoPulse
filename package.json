{
  "name": "egopulse-workspace",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": "24.x",
    "pnpm": "11.x"
  },
  "scripts": {
    "check": "pnpm run check:public-boundary && pnpm run check:boundaries && pnpm run check:contracts && pnpm run check:v01-contract-import && pnpm run check:contract-codegen && pnpm run check:package-integrity && node scripts/check-typescript.mjs",
    "check:public-boundary": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-public-boundary.ps1",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:contracts": "node scripts/check-proto.mjs && node scripts/check-approved-contract-change.mjs && node scripts/check-contract-breaking.mjs && node scripts/check-json-schema.mjs && node contracts/scripts/validate-candidate.js",
    "check:v01-contract-import": "node scripts/verify-v01-contract-import.mjs",
    "check:contract-codegen": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/contract-codegen.ps1 -Mode Check",
    "check:package-integrity": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-windows-package-integrity.ps1",
    "generate:contracts": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/contract-codegen.ps1 -Mode Write",
    "check:typescript": "node scripts/check-typescript.mjs",
    "desktop:dev": "pnpm --filter @egopulse/desktop tauri dev",
    "desktop:build": "pnpm --filter @egopulse/desktop tauri build",
    "package:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-windows.ps1",
    "ci:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local-ci.ps1",
    "cd:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local-cd.ps1",
    "cd:local:skip-ci": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local-cd.ps1 -SkipCi",
    "push:github": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/push-github.ps1"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.72.0",
    "@bufbuild/protoc-gen-es": "2.14.0",
    "ajv": "8.20.0",
    "typescript": "7.0.2"
  }
}
