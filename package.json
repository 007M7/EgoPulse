{
  "name": "egopulse-workspace",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": "24.x",
    "pnpm": "11.x"
  },
  "scripts": {
    "check": "pnpm run check:boundaries && pnpm run check:contracts && node scripts/check-typescript.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:contracts": "node scripts/check-proto.mjs && node scripts/check-json-schema.mjs",
    "check:typescript": "node scripts/check-typescript.mjs",
    "desktop:dev": "pnpm --filter @egopulse/desktop tauri dev",
    "desktop:build": "pnpm --filter @egopulse/desktop tauri build"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.72.0",
    "typescript": "7.0.2"
  }
}
